<!--
  Electric Atlas (2026 product), v0.1 (proportions measured on spec-sheet photos). Built from public data only.
  Every number has a source in docs/atlas-sources.md.
  Frame: x forward, y left, z up. Origin of pelvis = hip joint height.
  No actuators here: mjlab adds them from config.
-->
<mujoco model="atlas">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <joint damping="1" armature="0.01"/>
    <geom rgba="0.35 0.45 0.7 1"/>
    <site group="5" size="0.01" rgba="1 0 0 1"/>
  </default>

  <worldbody>
    <body name="pelvis" pos="0 0 0.999">
      <freejoint name="floating_base_joint"/>
      <geom name="pelvis" type="box" size="0.08 0.14 0.06" mass="12.78"/>
      <site name="imu_in_pelvis"/>

      <!-- Legs: hip yaw/roll/pitch share one point, ankle pitch/roll share one point. -->
      <body name="left_thigh" pos="0 0.09 0">
        <joint name="left_hip_yaw_joint" axis="0 0 1"/>
        <joint name="left_hip_roll_joint" axis="1 0 0" range="-0.5 0.5"/>
        <joint name="left_hip_pitch_joint" axis="0 1 0" range="-2.2 0.6"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.467" size="0.065" mass="9.0"/>
        <body name="left_shin" pos="0 0 -0.467">
          <joint name="left_knee_joint" axis="0 1 0" range="0 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.336" size="0.055" mass="4.185"/>
          <body name="left_foot" pos="0 0 -0.336">
            <joint name="left_ankle_pitch_joint" axis="0 1 0" range="-0.8 0.8"/>
            <joint name="left_ankle_roll_joint" axis="1 0 0" range="-0.4 0.4"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.116" size="0.045" mass="0.3"/>
            <geom name="left_foot" type="box" pos="0.04 0 -0.156" size="0.16 0.06 0.04" mass="1.005"/>
            <site name="left_foot" pos="0.04 0 -0.196"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.09 0">
        <joint name="right_hip_yaw_joint" axis="0 0 1"/>
        <joint name="right_hip_roll_joint" axis="1 0 0" range="-0.5 0.5"/>
        <joint name="right_hip_pitch_joint" axis="0 1 0" range="-2.2 0.6"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.467" size="0.065" mass="9.0"/>
        <body name="right_shin" pos="0 0 -0.467">
          <joint name="right_knee_joint" axis="0 1 0" range="0 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.336" size="0.055" mass="4.185"/>
          <body name="right_foot" pos="0 0 -0.336">
            <joint name="right_ankle_pitch_joint" axis="0 1 0" range="-0.8 0.8"/>
            <joint name="right_ankle_roll_joint" axis="1 0 0" range="-0.4 0.4"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.116" size="0.045" mass="0.3"/>
            <geom name="right_foot" type="box" pos="0.04 0 -0.156" size="0.16 0.06 0.04" mass="1.005"/>
            <site name="right_foot" pos="0.04 0 -0.196"/>
          </body>
        </body>
      </body>

      <!-- Waist yaw has no limit: the electric Atlas spins its torso all the way around. -->
      <body name="torso" pos="0 0 0.06">
        <joint name="waist_yaw_joint" axis="0 0 1"/>
        <geom name="torso" type="box" pos="0 0 0.27" size="0.12 0.14 0.22" mass="31.95"/>
        <site name="imu_in_torso" pos="0 0 0.27"/>

        <body name="head" pos="0 0 0.52">
          <joint name="neck_yaw_joint" axis="0 0 1"/>
          <geom name="head" type="sphere" pos="0 0 0.21" size="0.11" mass="7.29" rgba="0.9 0.9 0.85 1"/>
        </body>

        <body name="left_upper_arm" pos="0 0.20 0.521">
          <joint name="left_shoulder_pitch_joint" axis="0 1 0" range="-3.1 3.1"/>
          <joint name="left_shoulder_roll_joint" axis="1 0 0" range="-0.3 3.0"/>
          <joint name="left_shoulder_yaw_joint" axis="0 0 1" range="-2.6 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.05" mass="2.52"/>
          <body name="left_forearm" pos="0 0 -0.28">
            <joint name="left_elbow_joint" axis="0 1 0" range="-2.6 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.04" mass="1.44"/>
            <body name="left_hand" pos="0 0 -0.28">
              <joint name="left_wrist_yaw_joint" axis="0 0 1" range="-2.6 2.6"/>
              <joint name="left_wrist_pitch_joint" axis="0 1 0" range="-1.2 1.2"/>
              <joint name="left_wrist_roll_joint" axis="1 0 0" range="-1.2 1.2"/>
              <geom type="box" pos="0 0 -0.08" size="0.04 0.025 0.08" mass="0.54"/>
              <site name="left_palm" pos="0 0 -0.08"/>
            </body>
          </body>
        </body>

        <body name="right_upper_arm" pos="0 -0.20 0.521">
          <joint name="right_shoulder_pitch_joint" axis="0 1 0" range="-3.1 3.1"/>
          <joint name="right_shoulder_roll_joint" axis="1 0 0" range="-3.0 0.3"/>
          <joint name="right_shoulder_yaw_joint" axis="0 0 1" range="-2.6 2.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.05" mass="2.52"/>
          <body name="right_forearm" pos="0 0 -0.28">
            <joint name="right_elbow_joint" axis="0 1 0" range="-2.6 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.28" size="0.04" mass="1.44"/>
            <body name="right_hand" pos="0 0 -0.28">
              <joint name="right_wrist_yaw_joint" axis="0 0 1" range="-2.6 2.6"/>
              <joint name="right_wrist_pitch_joint" axis="0 1 0" range="-1.2 1.2"/>
              <joint name="right_wrist_roll_joint" axis="1 0 0" range="-1.2 1.2"/>
              <geom type="box" pos="0 0 -0.08" size="0.04 0.025 0.08" mass="0.54"/>
              <site name="right_palm" pos="0 0 -0.08"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
